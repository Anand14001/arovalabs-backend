# Copy to .env and fill in. Never commit .env.
# Every variable here is validated at boot by src/config/env.js.

NODE_ENV=development
PORT=4100
API_PREFIX=/api/v1
LOG_LEVEL=info

# PostgreSQL. Hosted (Prisma Postgres) in dev and production, so the server never
# needs to provide a database. Local Postgres via docker-compose.yml is an offline
# fallback: postgres://arova:arova@localhost:5433/arova_labs
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Direct connection is required by Prisma CLI for migrations and admin tooling.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Public origins. CORS_ORIGINS is a comma-separated allowlist and is REQUIRED in
# production; in development the Vite dev servers are allowed automatically.
PUBLIC_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4100
CORS_ORIGINS=

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The process refuses to start in production while these still say change-me.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Production only: lets admin.arovalabs.com send the refresh cookie to api.arovalabs.com
# COOKIE_DOMAIN=.arovalabs.com

# First admin account. Used by the seed only when no admin exists yet; changing
# these later does not alter an existing account.
ADMIN_EMAIL=admin@arovalabs.com
ADMIN_PASSWORD=change-me-before-production
ADMIN_NAME=Arova Admin

# Razorpay (test keys for now; rotate before going live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage. On cPanel point STORAGE_LOCAL_ROOT outside public_html so uploaded
# prescriptions and reports are never directly fetchable.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_MB=10

# Mail (cPanel mail account in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Arova Labs <no-reply@arovalabs.com>"

# Scheduled work.
#   inline   — node-cron inside the process (dev, Render)
#   external — cPanel cron calls the internal job route (Passenger stops idle apps)
JOB_RUNNER=inline
INTERNAL_JOB_TOKEN=

# Set to true behind LiteSpeed/cPanel, Render or Cloudflare so rate limiting and
# audit logs see the real client IP instead of the proxy's.
TRUST_PROXY=false
